{
	"name": "ailoha-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check": "tsgo -p tsconfig.json",
		"test": "npm test --workspaces --if-present",
		"test:core": "npm test --workspace=@ailoha/agent-core",
		"test:e2e": "npm run test:e2e --workspace=@ailoha/agent-tools",
		"test:e2e:live": "npm run build && node --env-file-if-exists=.env.local scripts/deepseek-http-e2e.mjs",
		"test:e2e:adapter-live": "npm run build && node --env-file-if-exists=.env.local scripts/deepseek-adapter-e2e-trace.mjs",
		"test:e2e:retry-live": "npm run build && node --env-file-if-exists=.env.local scripts/deepseek-retry-live-e2e.mjs",
		"test:e2e:compaction-live": "npm run build && node --env-file-if-exists=.env.local scripts/deepseek-context-compaction-e2e.mjs",
		"test:e2e:workspace-live": "npm run build && node --env-file-if-exists=.env.local scripts/deepseek-workspace-agents-md-live-e2e.mjs",
		"test:acceptance": "node --env-file-if-exists=.env.local scripts/run-agent-acceptance.mjs",
		"live:server": "npm run build && node --env-file-if-exists=.env.local scripts/deepseek-http-server.mjs",
		"demo:deepseek": "npm run build && node --env-file=.env.local scripts/deepseek-tool-call.mjs",
		"demo:deepseek:multi": "npm run build && node --env-file=.env.local scripts/deepseek-multi-tool-call.mjs",
		"demo:deepseek:batch": "npm run build && node --env-file=.env.local scripts/deepseek-batch-tool-call.mjs",
		"demo:deepseek:runtime": "npm run build && node --env-file-if-exists=.env.local scripts/deepseek-session-runtime.mjs",
		"demo:deepseek:queues": "npm run build && node --env-file=.env.local scripts/deepseek-steer-followup.mjs"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"vitest": "4.1.9"
	}
}
