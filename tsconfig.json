{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"strict": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"types": ["node"],
		"noEmit": true,
		"paths": {
			"@ailoha/agent-core": ["./packages/agent-core/src/index.ts"],
			"@ailoha/agent-service": ["./packages/agent-service/src/index.ts"],
			"@ailoha/chat-completions-adapter": ["./packages/chat-completions-adapter/src/index.ts"]
		}
	},
	"include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts"]
}
